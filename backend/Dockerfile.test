FROM python:3.11-slim

WORKDIR /app

# Install minimal dependencies
RUN pip install fastapi uvicorn

# Copy test app
COPY test_app.py .

# Expose port
EXPOSE 8000

# Run test app
CMD ["python", "-c", "import os; import uvicorn; uvicorn.run('test_app:app', host='0.0.0.0', port=int(os.getenv('PORT', 8000)))"]
